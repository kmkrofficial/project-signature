{
  "name": "signature",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "emulators": "npx --yes firebase-tools emulators:start",
    "emulators:export": "npx --yes firebase-tools emulators:start --export-on-exit=./emulator-data --import=./emulator-data",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore,storage --project demo-signature-rules \"node --test scripts/test-rules.mjs\"",
    "test:admin-access": "npx --yes firebase-tools emulators:exec --only auth --project demo-signature-admin \"node --test scripts/test-admin-access.mjs\""
  },
  "dependencies": {
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@uiw/react-md-editor": "^4.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss-selector-parser": "^7.1.6",
    "uuid": "^11.1.1"
  }
}
