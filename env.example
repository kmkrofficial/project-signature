# =====================================================================================================
# PUBLIC values. Anything starting with NEXT_PUBLIC_ is copied into the browser bundle for every visitor,
# so only put things here that are safe to publish. On Vercel, add these as the normal (non-sensitive) type.
# =====================================================================================================

# Which backend to use: "development" = local Firebase emulators (npm run emulators, then npm run seed:emulator);
# anything else ("staging", "production", or unset) = the real project configured by the keys below.
NEXT_PUBLIC_DEPLOYMENT=development

# Firebase web app config (Firebase console > Project settings > General > Your apps). These identify the
# project; your data is protected by the Firestore and Storage rules, not by hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Public site URL (canonical links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://keerthiraajan.dev

# =====================================================================================================
# SECRET values. Server only: never give these a NEXT_PUBLIC_ prefix. On Vercel, mark the private key and
# the salt as Sensitive.
# =====================================================================================================

# Firebase Admin SDK service account (Firebase console > Project settings > Service accounts)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Random secret used to anonymise reader IPs when deduplicating likes
LIKE_HASH_SALT=generate_a_long_random_string

# Who may use the Admin Studio (comma separated). When someone on this list signs in with a Google account
# whose email Google has verified, the server grants them the `admin` custom claim automatically.
ADMIN_EMAILS=you@example.com

# Alternative: grant the claim by hand (needs service-account.json):
#   node scripts/set-admin-claim.mjs you@example.com
