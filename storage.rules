rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Raster images only (SVG excluded: it can carry script), max 5 MB
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)');
    }

    // Public assets: anyone can fetch a file by URL, only admins can list or upload
    match /{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
  }
}
