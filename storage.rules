rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Blog & Media Assets: Publicly readable, admin writable
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default read allowed for public assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
