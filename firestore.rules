rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access is granted only via the `admin` custom claim
    // (set with scripts/set-admin-claim.mjs). Signing in alone grants nothing.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidPost(data) {
      return data.title is string
        && data.slug is string
        && data.slug.matches('^[a-z0-9-]+$')
        && data.published is bool
        && data.featured is bool
        && data.category in ['Artificial Intelligence', 'Web & Software', 'Cloud & Data', 'Guides & Tips']
        && (!('links' in data) || (data.links is list && data.links.size() <= 8));
    }

    // Articles: published posts are public; drafts are admin-only.
    // Likes are counted server-side via the Admin SDK, so there are no public writes.
    match /blog/{postId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidPost(request.resource.data);
      allow delete: if isAdmin();

      // Per-reader like markers, written only by the Admin SDK
      match /likers/{likerId} {
        allow read, write: if false;
      }

      // Saved versions of an article, for the studio's history view
      match /revisions/{revisionId} {
        allow read, write: if isAdmin();
      }
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
